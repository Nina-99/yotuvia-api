# ─── SERVER / RUNTIME ─────────────────────────────────────────────────────
# Port the HTTP server listens on. nginx proxies /api/ to this port.
PORT=8080
# release (production default) | debug. Debug prints the route table and verbose
# request diagnostics at boot, so never leave it on in production.
GIN_MODE=release
# Comma-separated IPs/CIDRs of the reverse proxies in front of this service.
# REQUIRED behind nginx: without it Gin trusts no proxy and every request is
# attributed to the proxy IP, so the per-IP rate limit shares one budget across
# all users. 127.0.0.1/32 covers a same-host nginx. An invalid value fails
# closed (trusts nothing) instead of trusting everyone.
TRUSTED_PROXIES=127.0.0.1/32
# Log level: debug | info | warn | error.
LOG_LEVEL=info
# console (human, for a terminal) | json (one object per line, for a log shipper).
LOG_FORMAT=json
# Max non-multipart JSON body size, in bytes. Default 2 MiB.
BODY_LIMIT_BYTES=2097152

# ─── CORS / FRONTEND ORIGINS ──────────────────────────────────────────────
# Browser origins allowed to call the API (CORS). Comma-separated.
# Unset -> falls back to FRONT_HOST, then http://localhost:5173.
# Production: the public web origin. A wrong/missing value does NOT fail boot,
# it silently falls back to localhost, so verify it after every deploy.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# The web dev server origin; also used as the CORS fallback.
FRONT_HOST=http://localhost:5173

# ─── DATABASE ─────────────────────────────────────────────────────────────
# PostgreSQL connection. With the bundled docker-compose.yml the database is
# reachable at 127.0.0.1:5432 and the defaults below match its POSTGRES_* vars.
#
# IMPORTANT: docker-compose.yml interpolates DB_USER/DB_PASSWORD/DB_NAME from
# the SHELL or a root .env file, NOT from this file (env_file only feeds the
# container). If you change the password here you must change it there too.
DB_HOST=localhost
DB_PORT=5432
DB_USER=yotuvia
DB_PASSWORD=yotuvia
DB_NAME=yotuvia
#
# The connection is built with sslmode=disable, which is only safe while the
# database listens on loopback (the compose file binds 127.0.0.1). For a remote
# database, terminate TLS and change configs/db.config.go instead.
#
# Helper scripts (scripts/*.go) accept a full DSN to override the vars above.
# DB_DSN=postgres://user:pass@host:5432/dbname?sslmode=require

# ─── AUTH / JWT ───────────────────────────────────────────────────────────
# REQUIRED. Signs every access/refresh token. The server does NOT fail at boot
# when it is missing: logins start failing at request time instead, which is a
# much worse way to find out. Generate one with:
#   openssl rand -base64 32
# Rotating it invalidates every session (all users must log in again).
JWT_SECRET=
# Optional dedicated key for the short-lived email-verification registration
# ticket. Unset -> falls back to JWT_SECRET. Recommended in production so a
# ticket cannot be forged with the session key.
REGISTRATION_TICKET_SECRET=
# Server-authoritative Terms version stamped on every accepted registration.
# A client-supplied version is never trusted.
TERMS_VERSION=1

# ─── DEMO DATA ────────────────────────────────────────────────────────────
# Seeds demo beauty centres on boot. MUST be false/empty in production.
SEED_DEMO_CENTERS=false

# ─── EMAIL (transactional) ────────────────────────────────────────────────
# Leave SMTP_HOST empty/unset to run the log-only dev mailer: registration and
# the verification/reset links are logged at INFO instead of sent, so the flows
# are testable end to end without credentials. Configure SMTP_HOST to go live.
#
# Gmail (local testing only): enable 2-Step Verification, create an App Password
# (Google Account > Security > App passwords) and use it here — the normal
# account password will be rejected. Gmail caps sending at ~500 recipients/day.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#   SMTP_FROM=you@gmail.com
#   SMTP_TLS_MODE=starttls
#
# Production: every major provider (Resend, Amazon SES, SendGrid, Postmark,
# Mailgun, Brevo) speaks SMTP, so switching is credentials only. Verify the
# sending domain (SPF + DKIM + DMARC) or Gmail will spam/reject the code email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (default, port 587) | tls (implicit TLS, port 465) | none
SMTP_TLS_MODE=starttls

# ─── APP DEEP LINKS ───────────────────────────────────────────────────────
# Base for the yotuvia:// links embedded in verification/reset emails. Replace
# with an https URL once a hosted web fallback exists for users without the app.
APP_DEEP_LINK_BASE_URL=yotuvia://

# ─── STAFF INVITATION LINKS ───────────────────────────────────────────────
# Base the API prefixes to the token in `POST /personnel/invitations`
# (`{ token, link }`). MUST end with `/` — a missing one is appended, so
# `https://yotuvia.com/join/` + token -> `https://yotuvia.com/join/<token>`.
# Unset -> falls back to the `yotuvia://join/` deep link (local dev).
INVITE_BASE_URL=https://yotuvia.com/join/

# ─── PLATFORM ADMIN (super_admin) ─────────────────────────────────────────
# The platform-level principal that oversees ALL beauty centres (validates
# token top-ups across centres, manages each centre's payment QR). It CANNOT be
# created through the public registration endpoints: the ONLY way it exists is
# this idempotent boot seed.
#
# Leave either credential unset/empty to skip seeding entirely (the boot logs a
# clear skip line). The password is hashed at seed time and never logged. An
# account that already exists is left untouched — a re-run NEVER overwrites the
# stored password, so rotating it is an explicit operator action (delete/rotate
# the row, then seed again).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional display name. Defaults to "Platform Admin" when unset.
SUPER_ADMIN_NAME=

# ─── SESSION CAP ──────────────────────────────────────────────────────────
# How many sessions a single account+role may keep ACTIVE at once. A session is
# one login (there is no device identity to key on), so this bounds how many
# places an account can be signed in simultaneously. A new login always
# succeeds: when it exceeds the cap, the OLDEST session(s) are revoked and the
# client is told via the `sessions_evicted` field on the auth response.
# Unset, non-numeric, blank or < 1 -> falls back to 2 (a typo never disables
# the cap).
MAX_ACTIVE_SESSIONS=2
# How long a just-rotated-but-revoked access token keeps working, in seconds,
# so an in-flight request is not 401'd while the client swaps tokens. Real
# revocations (logout, logout-all, password reset) are immediate regardless.
SESSION_REVOKE_GRACE_SEC=30

# ─── BACKGROUND SCHEDULER ─────────────────────────────────────────────────
# In-process maintenance loop: reminders, no-shows, holds, waitlist, referral
# expiry, boost sweeps, token alerts. Safe with multiple replicas (Postgres
# advisory lock makes exactly one fire each tick).
SCHEDULER_ENABLED=true
# Tick cadence in seconds. Default 60.
SCHEDULER_INTERVAL_SEC=60
# How long a pending referral waits before it expires. Default 30 days.
REFERRAL_EXPIRY_DAYS=30

# ─── SOCIAL LOGIN / OAUTH ─────────────────────────────────────────────────
# The API needs NO OAuth credentials of its own. For POST /auth-accounts/social
# it validates the token the CLIENT already obtained by calling the provider
# directly (utils/oauth.utils.go):
#   - Google: access token via www.googleapis.com/oauth2/v2/userinfo, or an
#     OpenID Connect ID token via oauth2.googleapis.com/tokeninfo;
#   - Facebook: Graph access token via graph.facebook.com/me.
# The token IS the credential, so there is nothing to configure here. The client
# ids live in yotuvia-web/.env.local and yotuvia-mobile/.env; see docs/oauth-setup.md.
# Never add OAuth client SECRETS to this file — they are unused by the API and
# must not be handed to client apps.

# ─── TIKTOK "CONNECT YOUR ACCOUNT" (Login Kit + Display API) ──────────────
# Lets a center connect its own TikTok account and import its videos. The whole
# integration is INERT until ALL FOUR values below are set: without them the
# /integrations/tiktok endpoints answer 503 and the web UI hides the action.
#
# Requires a TikTok developer app APPROVED for Login Kit + TikTok API with the
# user.info.basic and video.list scopes (until approval, only the app owner's own
# account works). The redirect URI must be registered exactly and be an absolute
# https URL with no query/fragment (e.g. https://api.yotuvia.com/api/integrations/tiktok/callback).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Base64-encoded 32-byte AES-256 key used to encrypt the user's access/refresh
# tokens at rest (the refresh token is valid 365 days on the user's behalf, so it
# must never be stored in plaintext). Generate one with:
#   openssl rand -base64 32
TIKTOK_TOKEN_KEY=

# ─── WEB PUSH (Phase C4) ──────────────────────────────────────────────────
# Lets the WEB app receive the same push notifications the mobile app gets.
# The feature is INERT until BOTH keys are set: without them the API refuses to
# store a browser subscription (400) and the web client hides the affordance, so
# a deployment that does not want web push keeps working unchanged.
#
# Generate ONCE and keep the pair stable — rotating the keys invalidates every
# existing subscription:
#   npx web-push generate-vapid-keys
# The public key is exposed at GET /api/push-devices/vapid-public-key (public on
# purpose: the browser needs it before it can subscribe).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the VAPID JWT (a mailto: or https: URL). Defaults to
# mailto:no-reply@yotuvia.app when unset.
VAPID_SUBJECT=

# ─── ABUSE / STORAGE GUARDS ───────────────────────────────────────────────
# Uploads are the only endpoints that write to the volume Postgres also lives
# on. A per-file cap (5MB receipts, 100MB videos) bounds ONE request, not the
# sum: at the global rate the receipt endpoint alone can write ~1.5GB/min.
#
# Canonical receipts directory. Avatar/centre/staff/video paths are relative to
# the process CWD (`uploads/<sub>`), so the systemd unit MUST set
# WorkingDirectory to the parent of `uploads/`, and nginx's `alias` must point
# at the same tree. UPLOAD_DIR only overrides the RECEIPTS subdirectory.
UPLOAD_DIR=./uploads/receipts

# Free-space floor. When the volume that holds UPLOAD_DIR drops below this, new
# uploads answer 503 instead of filling the disk (a full disk takes Postgres
# down with it — that is an outage, not a failed upload). Default: 2 GiB.
MIN_FREE_DISK_BYTES=2147483648

# Broad per-IP flood guard in front of every API route (default 300/min, burst
# 100). Generous on purpose: it absorbs floods and scraping sweeps, not normal
# use. Auth routes add a tighter limiter on top.
GLOBAL_RATE_LIMIT_IP_PER_MIN=300
GLOBAL_RATE_LIMIT_IP_BURST=100

# Auth limiter: per-IP budget and per-identifier (email/username) budget. The
# identifier dimension is what stops credential stuffing across rotating IPs.
# Defaults: 30/min per IP (burst 20), 5/min per identifier (burst 5).
RATE_LIMIT_IP_PER_MIN=30
RATE_LIMIT_IP_BURST=20
RATE_LIMIT_IDENTIFIER_PER_MIN=5
RATE_LIMIT_IDENTIFIER_BURST=5
# Limiter bookkeeping: idle TTL, sweep cadence, hard key cap per dimension.
RATE_LIMIT_TTL_SEC=600
RATE_LIMIT_SWEEP_SEC=60
RATE_LIMIT_MAX_ENTRIES=10000

# Per-IP budget for uploads, deliberately much tighter than the global 300/min.
# A human uploads a handful of photos, never dozens per minute.
RATE_LIMIT_UPLOAD_PER_MIN=12
RATE_LIMIT_UPLOAD_BURST=6

# Per-IP budget for the PUBLIC, expensive reads (/availability/search: a 14-day
# window across every eligible centre). Keeps the feature usable while it is not
# a free DoS amplifier or a competitor's agenda-scraping API.
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_SEARCH_BURST=15

# ─── TOKEN SOLVENCY / DISCOVERY ───────────────────────────────────────────
# A centre whose available funds (balance - holds + overdraft) hit zero can no
# longer settle the commission of a new visit. It keeps its profile and a grace
# period, then stops appearing in DISCOVERY (search, ranking, nearby) while
# staying reachable by id. Bookings against an unfundable centre are refused
# immediately, with a neutral message to the client.
#
# Hours of grace before a centre in deficit disappears from discovery.
# Default 168 (7 days). 0 hides it as soon as the deficit starts.
TOKEN_DEFICIT_GRACE_HOURS=168

# ─── TOKEN ALERTS & SUSPENSION ────────────────────────────────────────────
# Available Ytv (balance - holds + overdraft) at or below this triggers ONE
# "you are running out" notification to the centre owner. The alert is stamped
# per episode, so ten completed visits do not ten notifications.
TOKEN_LOW_BALANCE_YTV=10

# How long a centre may stay in deficit before the platform suspends it: it
# stops appearing in discovery AND can no longer receive bookings, and the owner
# gets a distinct notification. A top-up lifts the suspension automatically.
# 0 disables suspension.
TOKEN_SUSPEND_AFTER_HOURS=720

# ─── FEED GEO / BOOST REACH ───────────────────────────────────────────────
# The feed ranks nearby content first (proximity decays with distance, half-life
# 25 km) and the ad auction only considers campaigns whose centre is within this
# radius of the viewer. A viewer with no position (permission denied) gets the
# previous, non-geo behaviour.
#
# How far from the viewer a promoted centre may be to still be auctioned.
# Default 50 km (a city and its metropolitan ring). 0 disables the filter.
BOOST_MAX_RADIUS_KM=50

# How many BILLED views one viewer may produce for the same campaign before it
# stops being served to them. The advertiser pays per qualified view, so this is
# the number that protects both sides: the viewer stops seeing the same ad and
# the budget stops being spent on one person. Default 2. 0 disables the cap.
BOOST_FREQUENCY_CAP=2

# Organic items between two promoted slots (ads per page). Clamped to 3..20 so a
# typo can neither turn the feed into a billboard nor silently disable ads.
BOOST_SLOT_DENSITY=5

# HMAC key that signs billed-impression tokens. It MUST be identical across
# replicas (a token issued by one instance is verified by another). Unset -> a
# random per-process key is generated and the boot logs a warning; single-replica
# dev keeps working, but any restart invalidates outstanding tokens.
#   openssl rand -base64 32
BOOST_IMPRESSION_SECRET=

# ─── TOKEN TIERS ──────────────────────────────────────────────────────────
# Path to the top-up tier table (JSON). Defaults to configs/tiers.json next to
# the source tree; when running a packaged binary, point this at the real file.
TIERS_CONFIG_PATH=

# ─── TEST-ONLY (not read by the running server) ───────────────────────────
# SKIP_DB_TESTS: set to any value to skip the tests that need a real database.
# YOTUVIA_CORE_DIR: overrides the path to the yotuvia-core checkout used by the
# DTO contract tests (default: ../../yotuvia-core relative to this module).
# SKIP_DB_TESTS=
# YOTUVIA_CORE_DIR=
