# Browser origins allowed to call the API (CORS). Comma-separated.
# Unset -> falls back to FRONT_HOST, then http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# The web dev server origin; also used as the CORS fallback.
FRONT_HOST=http://localhost:5173

# ─── EMAIL (transactional) ────────────────────────────────────────────────
# Leave SMTP_HOST empty/unset to run the log-only dev mailer: registration and
# the verification/reset links are logged at INFO instead of sent, so the flows
# are testable end to end without credentials. Configure SMTP_HOST to go live.
#
# Every major provider (Resend, Amazon SES, SendGrid, Postmark, Gmail, Mailgun)
# speaks SMTP, so switching provider is credentials only — no code change.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (default, port 587) | tls (implicit TLS, port 465) | none
SMTP_TLS_MODE=starttls

# ─── APP DEEP LINKS ───────────────────────────────────────────────────────
# Base for the yotuvia:// links embedded in verification/reset emails. Replace
# with an https URL once a hosted web fallback exists for users without the app.
APP_DEEP_LINK_BASE_URL=yotuvia://

# ─── STAFF INVITATION LINKS ───────────────────────────────────────────────
# Base the API prefixes to the token in `POST /personnel/invitations`
# (`{ token, link }`). MUST end with `/` — a missing one is appended, so
# `https://yotuvia.com/join/` + token -> `https://yotuvia.com/join/<token>`.
# Unset -> falls back to the `yotuvia://join/` deep link (local dev).
INVITE_BASE_URL=https://yotuvia.com/join/

# ─── PLATFORM ADMIN (super_admin) ─────────────────────────────────────────
# The platform-level principal that oversees ALL beauty centres (validates
# token top-ups across centres, manages each centre's payment QR). It CANNOT be
# created through the public registration endpoints: the ONLY way it exists is
# this idempotent boot seed.
#
# Leave either credential unset/empty to skip seeding entirely (the boot logs a
# clear skip line). The password is hashed at seed time and never logged. An
# account that already exists is left untouched — a re-run NEVER overwrites the
# stored password, so rotating it is an explicit operator action (delete/rotate
# the row, then seed again).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# Optional display name. Defaults to "Platform Admin" when unset.
SUPER_ADMIN_NAME=

# ─── SESSION CAP ──────────────────────────────────────────────────────────
# How many sessions a single account+role may keep ACTIVE at once. A session is
# one login (there is no device identity to key on), so this bounds how many
# places an account can be signed in simultaneously. A new login always
# succeeds: when it exceeds the cap, the OLDEST session(s) are revoked and the
# client is told via the `sessions_evicted` field on the auth response.
# Unset, non-numeric, blank or < 1 -> falls back to 2 (a typo never disables
# the cap).
MAX_ACTIVE_SESSIONS=2

# ─── SOCIAL LOGIN / OAUTH ─────────────────────────────────────────────────
# The API needs NO OAuth credentials of its own. For POST /auth-accounts/social
# it validates the token the CLIENT already obtained by calling the provider
# directly (utils/oauth.utils.go):
#   - Google: access token via www.googleapis.com/oauth2/v2/userinfo, or an
#     OpenID Connect ID token via oauth2.googleapis.com/tokeninfo;
#   - Facebook: Graph access token via graph.facebook.com/me.
# The token IS the credential, so there is nothing to configure here. The client
# ids live in yotuvia-web/.env.local and yotuvia-mobile/.env; see docs/oauth-setup.md.
# Never add OAuth client SECRETS to this file — they are unused by the API and
# must not be handed to client apps.
